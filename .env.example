# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_UNIVERSITY_NAME="KIIT University"
NEXT_PUBLIC_KSAC_OFFICE="Campus 7, KIIT Student Activity Centre"

# Email Delivery (Resend or SMTP)
RESEND_API_KEY=re_your_api_key_here
NOTIFICATION_EMAIL_FROM="events@kiit.ac.in"

# QR Secret Key for HMAC signature
QR_SECRET_KEY=kiit_event_hub_hmac_secret_key_2026
